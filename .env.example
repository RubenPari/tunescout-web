# URL pubblico dell'app (senza / finale). Il redirect da registrare su Spotify
# è BASE_URL/api/auth/callback. In sviluppo con Vite usa http://127.0.0.1:5173
BASE_URL=http://127.0.0.1:8080

# Postgres (docker-compose lo imposta da solo per il servizio app)
DATABASE_URL=postgres://tunescout:tunescout@localhost:5432/tunescout?sslmode=disable

# App Spotify: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Claude: https://platform.claude.com
ANTHROPIC_API_KEY=

# Chiave per cifrare i token Spotify nel database: openssl rand -base64 32
# Se la cambi, gli utenti dovranno rifare l'accesso.
TOKEN_ENC_KEY=

# Opzionali
# TUNESCOUT_MODEL=claude-opus-5-5
# TUNESCOUT_EFFORT=medium
# DAILY_RUN_LIMIT=20
# MAX_CONCURRENT_JOBS=4
# ADDR=:8080
