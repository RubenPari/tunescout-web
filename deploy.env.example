# Configurazione di scripts/deploy-gcp.sh (make deploy).
# Copia in deploy.env (ignorato da git) e compila.

# --- Progetto GCP (creato dallo script se non esiste) ---
GCP_PROJECT_ID=tunescout-web-XXXX          # ID globale univoco, 6-30 caratteri
GCP_BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX   # gcloud billing accounts list
REGION=europe-west8                        # stessa regione del database

# --- Database: istanza Cloud SQL esistente (anche in un altro progetto) ---
DB_PROJECT=my-db-project               # progetto che ospita l'istanza
DB_INSTANCE=my-postgres-instance
DB_NAME=tunescout                          # creato se manca
DB_USER=tunescout_app                      # creato se manca, password generata

# --- Segreti (salvati in Secret Manager) ---
# Obbligatori al primo deploy; se lasciati vuoti dopo, restano i valori già salvati.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
ANTHROPIC_API_KEY=
# TOKEN_ENC_KEY viene generata al primo deploy e non viene più cambiata.

# --- Opzionali ---
# BASE_URL=https://tunescout.example.com   # dominio personalizzato; default: URL di Cloud Run
# SERVICE=tunescout-web
# MIN_INSTANCES=0                          # 1 = niente cold start (costa di più)
# MEMORY=512Mi
# TUNESCOUT_MODEL=claude-opus-5-5
# TUNESCOUT_EFFORT=medium
# DAILY_RUN_LIMIT=20
# MAX_CONCURRENT_JOBS=4
